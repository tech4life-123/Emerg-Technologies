# Public site URL (set to your production domain; enables canonical URLs, sitemap host, OG URLs)
NEXT_PUBLIC_SITE_URL=
# Optional: shown as a mailto fallback if the form cannot send
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: footer copyright year (defaults to 2026)
NEXT_PUBLIC_COPYRIGHT_YEAR=

# Contact form delivery via Resend (https://resend.com). Without these the form
# honestly reports "not sent" instead of faking success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
